# Apache (cPanel): forzar HTTPS + www, compresión y caché del navegador.
RewriteEngine On
# Solo en el dominio real (la URL temporal por IP sigue funcionando).
RewriteCond %{HTTP_HOST} zcorp23\.com$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.zcorp23.com%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Los archivos de /assets llevan hash en el nombre: se pueden cachear 1 año.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  # index.html siempre fresco para que los cambios se vean al instante.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
